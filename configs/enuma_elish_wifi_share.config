# =============================================================================
# Kernel .config fragment for: enuma (SM8250 + external SDX55M) hardware
# running the elish (WiFi-only) ROM, fixing "EasyTether connect kills WiFi".
#
# Reference config: /proc/config.gz from
#   Linux 4.19.325-cip127-st11-aptusitu-perf+  (device, 2026-11-13)
#
# Usage (from the kernel source root of your other build task):
#   ARCH=arm64 scripts/kconfig/merge_config.sh \
#       arch/arm64/configs/<your_defconfig> \
#       /path/to/enuma_elish_wifi_share.config
#   # or paste the lines below into your defconfig / .config before `make`.
#
# IMPORTANT: this fragment alone does NOT fix the bug.  It keeps the SSR
# subsystem from panicking and documents the required options.  The actual
# fix is 0001-soc-qcom-subsystem_restart-skip-esoc0.patch (source patch).
# =============================================================================

# --- must stay enabled: GNSS needs the external modem, WiFi needs CNSS2 -----
CONFIG_ESOC=y
CONFIG_ESOC_DEV=y
CONFIG_ESOC_CLIENT=y
CONFIG_ESOC_MDM_4X=y
CONFIG_ESOC_MDM_DRV=y
CONFIG_MHI_BUS=y
CONFIG_MHI_QCOM=y
CONFIG_MHI_NETDEV=y
CONFIG_QRTR_MHI=y
CONFIG_CNSS2=y
CONFIG_CNSS2_QMI=y
CONFIG_CNSS_QCA6390=y
CONFIG_CNSS_QMI_SVC=y
CONFIG_CNSS_GENL=y
CONFIG_CNSS_ASYNC=y
CONFIG_CFG80211=y
CONFIG_WLAN=y
CONFIG_MSM_SUBSYSTEM_RESTART=y
CONFIG_MSM_PIL=y
CONFIG_MSM_PIL_SSR_GENERIC=y

# --- CHANGED: esoc0 errfatals every ~13 s.  A late SSR notification must
#     not reboot the whole SoC.  (was CONFIG_PANIC_ON_SSR_NOTIF_TIMEOUT=y)
# CONFIG_PANIC_ON_SSR_NOTIF_TIMEOUT is not set
CONFIG_SETUP_SSR_NOTIF_TIMEOUTS=y
CONFIG_SSR_SYSMON_NOTIF_TIMEOUT=20000
CONFIG_SSR_SUBSYS_NOTIF_TIMEOUT=20000

# --- optional noise reduction; does NOT stop the restart loop by itself ----
# CONFIG_MHI_DEBUG is not set
# CONFIG_MHI_UCI is not set
# CONFIG_MHI_SATELLITE is not set

# --- explicitly NOT changed -------------------------------------------------
# There is no CONFIG_* switch that removes esoc0 from the coupled
# ("RELATED") restart group.  /sys/bus/msm_subsys/devices/subsys10/
# restart_level is read-only on this kernel and runtime writes of
# disable_restart_work=1/2 were verified ineffective.  Hence the patch.
