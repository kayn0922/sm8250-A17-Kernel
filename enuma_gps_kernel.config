# =============================================================================
# Kernel .config fragment for: enuma (SM8250 + external SDX55M) hardware
# running an elish (WiFi-only) ROM, with the v4 GPS module's kernel-side
# requirements AND the communication-share (EasyTether) SSR-isolation fix.
#
# Reference running kernel: 4.19.325-cip127-st11-aptusitu-perf+  (device, 2026-11-13)
# Builder base: ymdzq/kernel_xiaomi_sm8250_mod @ android16-aptusitu
#
# TWO ways to use this:
#   A) WITH the builder (recommended): scripts/apply_patches.sh already force-
#      writes every option below into <device>_defconfig, AND applies the SSR
#      patch.  You do NOT need to merge this file separately.  Just run the
#      builder with device=enuma (see GPS_KERNEL_INTEGRATION.md).
#   B) WITHOUT the builder: merge into your defconfig before `make`:
#        ARCH=arm64 scripts/kconfig/merge_config.sh \
#            arch/arm64/configs/<device>_defconfig enuma_gps_kernel.config
#
# IMPORTANT: this fragment only covers the KERNEL side.  The v4 GPS module's
# userspace parts (resetprop ro.baseband=mdm, vendor file overlays, launching
# the QTI GNSS HAL + qcrild, sepolicy, darkmode heal, flashlight feature
# override) CANNOT live in the kernel and MUST stay in the KernelSU module.
# See GPS_KERNEL_INTEGRATION.md for the full split.
# =============================================================================

# --- external modem (SDX55M) + GNSS transport: REQUIRED for the v4 GPS fix ---
# The module powers the X55 via baseband=mdm + mdm_helper and runs the QTI
# GNSS HAL over QMI_LOC.  Without these, the modem subsystem is not compiled
# in and GPS-via-modem cannot work (elish_defconfig, being WiFi-only, omits
# them - hence device=enuma is the safe choice).
CONFIG_ESOC=y
CONFIG_ESOC_DEV=y
CONFIG_ESOC_CLIENT=y
CONFIG_ESOC_MDM_4X=y
CONFIG_ESOC_MDM_DRV=y
CONFIG_MHI_BUS=y
CONFIG_MHI_QCOM=y
CONFIG_MHI_NETDEV=y
CONFIG_QRTR_MHI=y
CONFIG_MSM_SUBSYSTEM_RESTART=y
CONFIG_MSM_PIL=y
CONFIG_MSM_PIL_SSR_GENERIC=y
CONFIG_CNSS2=y
CONFIG_CNSS2_QMI=y

# --- these are already forced by apply_patches.sh; listed for completeness ---
CONFIG_AIROHA_GPS=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_GLINK=y
CONFIG_DIAG_CHAR=y

# --- SSR isolation: keep the ~13 s modem errfatal from resetting wlan/cnss ---
# (the actual code change is patches/0001-...-subsystem_restart-skip-esoc0.patch;
#  this only relaxes the SSR-notify timeout so a late notification cannot panic)
# CONFIG_PANIC_ON_SSR_NOTIF_TIMEOUT is not set
CONFIG_SETUP_SSR_NOTIF_TIMEOUTS=y
CONFIG_SSR_SYSMON_NOTIF_TIMEOUT=20000
CONFIG_SSR_SUBSYS_NOTIF_TIMEOUT=20000

# --- DO NOT disable these "to reduce noise"; they are what GPS/WiFi need -----
# CONFIG_MHI_DEBUG is not set
# CONFIG_MHI_UCI is not set
# CONFIG_MHI_SATELLITE is not set
